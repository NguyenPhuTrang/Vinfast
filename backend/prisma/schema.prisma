// ==========================================
// PRISMA CLIENT
// ==========================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

// ==========================================
// DATABASE
// ==========================================

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS (7)
// ==========================================

enum Role {
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE

  INACTIVE
  SUSPENDED

  @@map("user_status")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("content_status")
}

enum MediaType {
  IMAGE
  VIDEO

  @@map("media_type")
}

enum VehicleMediaRole {
  HERO
  EXTERIOR
  INTERIOR
  GALLERY
  VIDEO
  THUMBNAIL

  @@map("vehicle_media_role")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  UNPUBLISH
  LOGIN
  LOGOUT
  TOKEN_REFRESH

  @@map("audit_action")
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM

  @@map("contact_status")
}

// ==========================================
// 1. AUTHENTICATION & USERS (3 TABLES)
// ==========================================

model User {
  id String @id @default(uuid()) @db.Uuid

  // Google Authentication
  googleId  String? @unique @map("google_id") @db.VarChar(255)
  email     String  @unique @db.VarChar(255)
  fullName  String  @map("full_name") @db.VarChar(150)
  avatarUrl String? @map("avatar_url") @db.Text

  role   Role       @default(ADMIN)
  status UserStatus @default(ACTIVE)

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  authoredArticles NewsArticle[]       @relation("ArticleAuthor")
  assignedContacts ContactSubmission[] @relation("ContactAssignee")
  uploadedMedia    MediaAsset[]        @relation("MediaUploader")

  @@index([role, status])
  @@map("users")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // SHA-256 hash of the refresh token
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  // Tokens from the same login session share a familyId
  familyId String @default(uuid()) @map("family_id") @db.Uuid

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  ipAddress  String? @map("ip_address") @db.VarChar(45)
  userAgent  String? @map("user_agent") @db.Text
  deviceName String? @map("device_name") @db.VarChar(120)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, expiresAt])
  @@index([familyId])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  actorId String? @map("actor_id") @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action AuditAction

  entityType String  @map("entity_type") @db.VarChar(100)
  entityId   String? @map("entity_id") @db.VarChar(100)

  description String? @db.Text
  metadata    Json?   @db.JsonB

  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ==========================================
// 2. VEHICLE MANAGEMENT (6 TABLES)
// ==========================================

model VehicleCategory {
  id String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(100)
  slug        String  @unique @db.VarChar(120)
  description String? @db.Text

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  vehicles Vehicle[]

  @@index([isActive, sortOrder])
  @@map("vehicle_categories")
}

model Vehicle {
  id String @id @default(uuid()) @db.Uuid

  categoryId String          @map("category_id") @db.Uuid
  category   VehicleCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name      String  @db.VarChar(150)
  slug      String  @unique @db.VarChar(180)
  modelCode String? @map("model_code") @db.VarChar(80)

  tagline          String? @db.VarChar(255)
  shortDescription String? @map("short_description") @db.Text
  description      String? @db.Text

  status     ContentStatus @default(DRAFT)
  isFeatured Boolean       @default(false) @map("is_featured")
  sortOrder  Int           @default(0) @map("sort_order")

  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  seoTitle       String? @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  variants VehicleVariant[]
  media    VehicleMedia[]

  @@index([categoryId, status, sortOrder])
  @@index([status, publishedAt])
  @@index([isFeatured, status])
  @@map("vehicles")
}

model VehicleVariant {
  id String @id @default(uuid()) @db.Uuid

  vehicleId String  @map("vehicle_id") @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(120)
  code        String  @db.VarChar(80)
  description String? @db.Text

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  specifications VehicleSpecification[]
  media          VehicleMedia[]

  @@unique([vehicleId, code])
  @@index([vehicleId, isActive, sortOrder])
  @@map("vehicle_variants")
}

model VehicleSpecification {
  id String @id @default(uuid()) @db.Uuid

  variantId String         @map("variant_id") @db.Uuid
  variant   VehicleVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  groupName String @map("group_name") @db.VarChar(120)
  key       String @db.VarChar(100)
  label     String @db.VarChar(150)

  value        String   @db.VarChar(255)
  numericValue Decimal? @map("numeric_value") @db.Decimal(14, 4)
  unit         String?  @db.VarChar(40)

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([variantId, key])
  @@index([variantId, groupName, sortOrder])
  @@index([key])
  @@map("vehicle_specifications")
}

// ==========================================
// 3. MEDIA MANAGEMENT (1 TABLE)
// ==========================================

model MediaAsset {
  id String @id @default(uuid()) @db.Uuid

  originalName String @map("original_name") @db.VarChar(255)
  storageKey   String @unique @map("storage_key") @db.VarChar(500)
  publicUrl    String @map("public_url") @db.Text

  mimeType  String    @map("mime_type") @db.VarChar(120)
  mediaType MediaType @map("media_type")

  sizeBytes BigInt @map("size_bytes")

  width           Int?
  height          Int?
  durationSeconds Decimal? @map("duration_seconds") @db.Decimal(10, 3)

  altText String? @map("alt_text") @db.Text

  uploadedById String? @map("uploaded_by_id") @db.Uuid
  uploadedBy   User?   @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  vehicleMedia       VehicleMedia[]
  newsCovers         NewsArticle[]  @relation("ArticleCover")
  galleryItems       GalleryItem[]
  galleryAlbumCovers GalleryAlbum[] @relation("AlbumCover")

  @@index([mediaType, createdAt])
  @@index([uploadedById])
  @@map("media_assets")
}

// ==========================================
// 4. VEHICLE MEDIA (1 TABLE)
// ==========================================

model VehicleMedia {
  id String @id @default(uuid()) @db.Uuid

  vehicleId String  @map("vehicle_id") @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  variantId String?         @map("variant_id") @db.Uuid
  variant   VehicleVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  mediaAssetId String     @map("media_asset_id") @db.Uuid
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  role      VehicleMediaRole @default(GALLERY)
  isPrimary Boolean          @default(false) @map("is_primary")
  sortOrder Int              @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([vehicleId, role, sortOrder])
  @@index([variantId])
  @@index([mediaAssetId])
  @@map("vehicle_media")
}

// ==========================================
// 5. NEWS MANAGEMENT (2 TABLES)
// ==========================================

model NewsCategory {
  id String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(120)
  slug        String  @unique @db.VarChar(150)
  description String? @db.Text

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  articles NewsArticle[]

  @@index([isActive, sortOrder])
  @@map("news_categories")
}

model NewsArticle {
  id String @id @default(uuid()) @db.Uuid

  categoryId String       @map("category_id") @db.Uuid
  category   NewsCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  authorId String @map("author_id") @db.Uuid
  author   User   @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  coverMediaId String?     @map("cover_media_id") @db.Uuid
  coverMedia   MediaAsset? @relation("ArticleCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  title   String  @db.VarChar(255)
  slug    String  @unique @db.VarChar(280)
  excerpt String? @db.Text

  // Rich text / block-based article content
  content Json @db.JsonB

  status      ContentStatus @default(DRAFT)
  isFeatured  Boolean       @default(false) @map("is_featured")
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(3)

  seoTitle       String? @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([categoryId, status])
  @@index([authorId, createdAt])
  @@index([status, publishedAt])
  @@index([isFeatured, status])
  @@map("news_articles")
}

// ==========================================
// 6. PAGE MANAGEMENT (2 TABLES)
// ==========================================

model Page {
  id String @id @default(uuid()) @db.Uuid

  title       String  @db.VarChar(200)
  slug        String  @unique @db.VarChar(220)
  description String? @db.Text

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(3)

  seoTitle       String? @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sections PageSection[]

  @@index([status, publishedAt])
  @@map("pages")
}

model PageSection {
  id String @id @default(uuid()) @db.Uuid

  pageId String @map("page_id") @db.Uuid
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  sectionType String  @map("section_type") @db.VarChar(80)
  title       String? @db.VarChar(255)

  // Dynamic section content stored as JSONB
  content Json @db.JsonB

  sortOrder Int     @default(0) @map("sort_order")
  isVisible Boolean @default(true) @map("is_visible")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([pageId, isVisible, sortOrder])
  @@map("page_sections")
}

// ==========================================
// 7. GALLERY MANAGEMENT (2 TABLES)
// ==========================================

model GalleryAlbum {
  id String @id @default(uuid()) @db.Uuid

  title       String  @db.VarChar(200)
  slug        String  @unique @db.VarChar(220)
  description String? @db.Text

  coverMediaId String?     @map("cover_media_id") @db.Uuid
  coverMedia   MediaAsset? @relation("AlbumCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  status      ContentStatus @default(DRAFT)
  sortOrder   Int           @default(0) @map("sort_order")
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items GalleryItem[]

  @@index([status, sortOrder])
  @@map("gallery_albums")
}

model GalleryItem {
  id String @id @default(uuid()) @db.Uuid

  albumId String       @map("album_id") @db.Uuid
  album   GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  mediaAssetId String     @map("media_asset_id") @db.Uuid
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  caption   String? @db.Text
  altText   String? @map("alt_text") @db.Text
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([albumId, mediaAssetId])
  @@index([albumId, sortOrder])
  @@map("gallery_items")
}

// ==========================================
// 8. FAQ MANAGEMENT (1 TABLE)
// ==========================================

model FaqItem {
  id String @id @default(uuid()) @db.Uuid

  category String @db.VarChar(100)
  question String @db.VarChar(500)
  answer   String @db.Text

  status    ContentStatus @default(DRAFT)
  sortOrder Int           @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([category, status, sortOrder])
  @@map("faq_items")
}

// ==========================================
// 9. CONTACT MANAGEMENT (1 TABLE)
// ==========================================

model ContactSubmission {
  id String @id @default(uuid()) @db.Uuid

  fullName String  @map("full_name") @db.VarChar(150)
  email    String  @db.VarChar(255)
  phone    String? @db.VarChar(30)

  subject String @db.VarChar(255)
  message String @db.Text

  status ContactStatus @default(NEW)

  assignedToId String? @map("assigned_to_id") @db.Uuid
  assignedTo   User?   @relation("ContactAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@index([email])
  @@map("contact_submissions")
}
