
# ==========================================
# APPLICATION
# ==========================================

NODE_ENV=development
PORT=4000

# ==========================================
# API CONFIGURATION
# ==========================================

API_PREFIX=api
API_VERSION=1

# ==========================================
# CORS
# ==========================================

CORS_ORIGIN=http://localhost:3000

# ==========================================
# POSTGRESQL - DOCKER
# ==========================================

POSTGRES_USER=vinfast_user
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=vinfast_db
POSTGRES_PORT=5433

# ==========================================
# PRISMA DATABASE CONNECTION
# ==========================================

DATABASE_URL="postgresql://vinfast_user:YOUR_PASSWORD@127.0.0.1:5433/vinfast_db?schema=public"

# ==========================================
# AUTHENTICATION - JWT
# ==========================================

JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
JWT_ACCESS_EXPIRES_IN=900
